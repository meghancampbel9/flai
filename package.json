{
  "name": "flai",
  "private": true,
  "description": "AI-powered ecommerce platform with React Native and FastAPI",
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build:mobile",
    "build:api": "turbo run build:api",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev:mobile",
    "dev:api": "turbo run dev:api",
    "lint": "turbo run lint",
    "lint:mobile": "turbo run lint:mobile",
    "lint:api": "turbo run lint:api",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "mobile": "cd apps/mobile && pnpm start",
    "api": "cd apps/api && python main.py"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
